# Example inventory for Barq Task 01
# Copy or generate this file as inventory/hosts.ini

[app]
app01 ansible_host=203.0.113.10 private_ip=10.0.1.10

[db]
db01 ansible_host=10.0.2.10 private_ip=10.0.2.10

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/barq-task01
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
