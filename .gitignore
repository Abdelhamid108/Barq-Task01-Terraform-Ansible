# ==========================================
# Terraform State, Variables & Secrets
# ==========================================
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore local variable files containing actual secrets/IPs
*.tfvars
*.tfvars.json

# Explicitly allow example tfvars file for team sharing
!terraform.tfvars.example
!*.tfvars.example

# ==========================================
# SSH Keys, Passwords & Credentials
# ==========================================
*.pem
*.pub
*.key
id_rsa*
id_ed25519*
.vault_pass
vault_pass*
Ansible/vault/.vault.txt
.vault.txt
*.vault.txt
*.private

# ==========================================
# Ansible Dynamic & Generated Files
# ==========================================
ansible/inventory/hosts.ini
ansible/inventory/hosts.yml
Ansible/inventory/hosts.ini
Ansible/inventory/hosts.yml
.ansible/
Ansible/.ansible/
*.retry

# ==========================================
# Application, Environment & Runtime
# ==========================================
.env
.env.*
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ==========================================
# Operating System & IDE Artifacts
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
